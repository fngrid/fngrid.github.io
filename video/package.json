{
  "name": "fngrid-demo-video",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Demo ../assets/demo.mp4 --codec=h264 --crf=26 --pixel-format=yuv420p",
    "poster": "remotion still src/index.ts Demo ../assets/poster.jpg --frame=700 --image-format=jpeg",
    "og": "remotion still src/index.ts OG ../assets/og.png",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.535",
    "@remotion/google-fonts": "^4.0.535",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.535"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
